{
  "path_root": "..",
  "defaults": {
    "prompt": "A person standing in a room",
    "checkpoint": "models/JointLight/JointLight.safetensors",
    "model_config": "model_configs.json",
    "tokenizer_path": "models/Wan-AI/Wan2.2-TI2V-5B/google/umt5-xxl",
    "output_dir": "outputs/examples",
    "num_frames": 81,
    "cfg_scale": 1.0,
    "shading_timestep_init": 0.6,
    "input_timestep_init": 1.0,
    "seed": 1,
    "shading_exposure_ev": "auto",
    "shading_spp": 64,
    "envmap_display_transform": "source",
    "no_comparison": false
  },
  "videos": [
    {"path": "examples/videos/video_0.mp4", "prompt": "A boy sitting indoors"},
    {"path": "examples/videos/video_1.mp4", "prompt": "A cat"},
    {"path": "examples/videos/video_2.mp4"},
    {"path": "examples/videos/video_3.mp4"},
    {"path": "examples/videos/video_4.mp4"},
    {"path": "examples/videos/video_5.mp4"}
  ],
  "hdris": [
    {"path": "examples/hdris/blinds_1k.hdr", "rotate": "NONE"},
    {"path": "examples/hdris/cobblestone_street_night_1k.hdr", "rotate": "NONE"},
    {"path": "examples/hdris/dry_field_1k.hdr", "rotate": "CW", "envmap_angle": 0.0},
    {"path": "examples/hdris/park_bench_1k.hdr", "rotate": "NONE"}
  ]
}
